---
// Build-time static data fetch from Payload CMS
const CMS_URL = import.meta.env.PUBLIC_CMS_URL || 'https://pfh-cms.cloudgenz.com';

let data = null;
let errorMsg = null;
let imageUrl = null;

try {
  const res = await fetch(`${CMS_URL}/api/globals/astro-test-page?depth=2`);
  if (!res.ok) {
    throw new Error(`Payload returned HTTP status ${res.status}`);
  }
  data = await res.json();

  if (data?.test_image) {
    if (typeof data.test_image === 'object' && data.test_image.url) {
      const rawUrl = data.test_image.url;
      imageUrl = rawUrl.startsWith('http') ? rawUrl : `${CMS_URL}${rawUrl.startsWith('/') ? '' : '/'}${rawUrl}`;
    }
  }
} catch (err) {
  errorMsg = err instanceof Error ? err.message : String(err);
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro + Payload CMS SSG Test</title>
		<style>
			body {
				font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
				background-color: #0f172a;
				color: #f8fafc;
				max-width: 800px;
				margin: 40px auto;
				padding: 24px;
			}
			.card {
				background: #1e293b;
				border-radius: 12px;
				padding: 28px;
				border: 1px solid #334155;
				box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
			}
			.tag {
				display: inline-block;
				background: #3b82f6;
				color: white;
				padding: 4px 12px;
				border-radius: 9999px;
				font-size: 0.85rem;
				font-weight: 600;
				margin-bottom: 16px;
			}
			h1 {
				color: #60a5fa;
				font-size: 2.25rem;
				margin-top: 0;
			}
			.image-box {
				margin-top: 20px;
				border-radius: 8px;
				overflow: hidden;
				border: 2px dashed #475569;
				padding: 16px;
				text-align: center;
			}
			img {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
			}
			.info {
				margin-top: 24px;
				font-size: 0.9rem;
				color: #94a3b8;
				line-height: 1.6;
			}
			code {
				background: #0f172a;
				color: #38bdf8;
				padding: 2px 6px;
				border-radius: 4px;
			}
		</style>
	</head>
	<body>
		<div class="card">
			<span class="tag">Live Preview Enabled</span>
			
			{errorMsg ? (
				<div style="color: #f87171;">
					<h2>Error fetching data:</h2>
					<p>{errorMsg}</p>
				</div>
			) : (
				<div>
					<h1>Heading: <span id="test-heading">{data?.test_heading || 'No Heading Set'}</span></h1>

					<div class="image-box" id="image-container">
						{imageUrl ? (
							<div>
								<p><strong>Uploaded Image from Payload CMS:</strong></p>
								<img id="test-image" src={imageUrl} alt="Test Image from Payload CMS" />
							</div>
						) : (
							<div id="image-placeholder">
								<p style="color: #94a3b8; font-style: italic;">
									📷 Image is currently empty. Upload an image in Payload CMS Admin!
								</p>
								<img id="test-image" src="" alt="Test Image" style="display: none;" />
							</div>
						)}
					</div>
				</div>
			)}

			<div class="info">
				<p>⚡ <strong>How this works:</strong></p>
				<ul>
					<li>Pre-rendered at <strong>build time</strong> directly from Payload CMS.</li>
					<li>When loaded inside Payload Admin iframe, <code>@payloadcms/live-preview</code> updates DOM elements in <strong>real-time</strong> as you type!</li>
				</ul>
			</div>
		</div>

		<script define:vars={{ CMS_URL }}>
			// 1. Notify Payload Admin that preview iframe is ready to receive live updates
			if (window.parent && window.parent !== window) {
				window.parent.postMessage('payload-live-preview-ready', '*');
			}

			// 2. Listen for Payload Admin live preview messages in real time!
			window.addEventListener('message', (event) => {
				try {
					let raw = event.data;
					if (typeof raw === 'string') {
						try { raw = JSON.parse(raw); } catch (e) {}
					}

					const liveData = raw?.data || raw;
					if (!liveData || typeof liveData !== 'object') return;

					// Update heading in real-time
					if (liveData.test_heading !== undefined) {
						const headingEl = document.getElementById('test-heading');
						if (headingEl) headingEl.innerText = liveData.test_heading;
					}

					// Update image in real-time
					if (liveData.test_image) {
						let imgUrl = null;
						if (typeof liveData.test_image === 'object' && liveData.test_image.url) {
							imgUrl = liveData.test_image.url;
						} else if (typeof liveData.test_image === 'string') {
							imgUrl = liveData.test_image;
						}
						
						if (imgUrl) {
							const fullUrl = imgUrl.startsWith('http') ? imgUrl : `${CMS_URL}${imgUrl.startsWith('/') ? '' : '/'}${imgUrl}`;
							const imgEl = document.getElementById('test-image');
							const placeholder = document.getElementById('image-placeholder');
							if (imgEl) {
								imgEl.src = fullUrl;
								imgEl.style.display = 'inline-block';
							}
							if (placeholder) {
								placeholder.style.display = 'none';
							}
						}
					}
				} catch (e) {
					// Ignore non-json postMessages
				}
			});
		</script>
	</body>
</html>
